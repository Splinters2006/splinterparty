# Optional Spotify integration. Copy to .env and fill in your own values.
# Create a Web API + Web Playback SDK app in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
# HTTPS is required on a real server. No trailing path.
PUBLIC_URL=https://party.example.com
# Register exactly PUBLIC_URL + /api/spotify/callback with Spotify.
# Local development only: PUBLIC_URL=http://127.0.0.1:3000
PORT=3000
